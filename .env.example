# Single admin mailbox (everyone else who signs in is a member)
ADMIN_EMAIL=klef2007.2013@gmail.com

# Minutes of inactivity after which the next visit requires sign-in again (default 30)
SESSION_IDLE_MINUTES=30

# Email delivery for new login/account requests (to ADMIN_EMAIL + President/Treasurer).
# Preferred: Resend (https://resend.com) — required for inbox delivery without SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL="KLEF 13 <onboarding@resend.dev>"
# Optional SMTP fallback (e.g. Gmail app password / workspace SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="KLEF 13 <klef2007.2013@gmail.com>"
# Optional absolute app URL used in notification links
# APP_BASE_URL=https://klefapp--klefapp.europe-west4.hosted.app
# (use https://shsnklef13.com once the custom domain is live)
#
# Without Resend/SMTP, requests still appear on Access (badge/banner). A Firestore
# `mail` document is also queued for the optional Firebase Trigger Email extension.

# Firebase web client (Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin (service account JSON fields)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
