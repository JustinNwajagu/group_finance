# Single admin mailbox (everyone else who signs in is a member)
ADMIN_EMAIL=klef2007.2013@gmail.com

# Minutes of inactivity after which the next visit requires sign-in again (default 15)
SESSION_IDLE_MINUTES=15

# Optional SMTP for access-request alerts (to ADMIN_EMAIL + President/Treasurer).
# Password resets use Firebase Auth email; SMTP is only a fallback.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="KLEF 13 <klef2007.2013@gmail.com>"
# Optional absolute app URL used in notification / reset continue links
# APP_BASE_URL=https://shsnklef13.com
#
# Without SMTP, access requests still appear on Access (badge/banner). A Firestore
# `mail` document is also queued for the optional Firebase Trigger Email extension.

# Firebase web client (Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin (service account JSON fields)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
