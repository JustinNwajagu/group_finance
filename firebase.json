{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "shsnklef",
      "public": "hosting/shsnklef",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "regex": "^/(.*)$",
          "destination": "https://klefapp--klefapp.europe-west4.hosted.app/:1",
          "type": 302
        }
      ]
    }
  ]
}
